# Copy to .env (gitignored) to use real models; without it, forge serves mocks.
#
# Gemini as forge's fallback. forge sends a request to the fallback only when
# the primary fails, so with the mock primary running, answers still come from
# the mock. Stop it (docker compose stop mock-vllm) to have Gemini answer
# everything, or set the FORGE_PRIMARY_* variables to Gemini instead.
FORGE_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# gemini-2.0-flash (forge's default) was shut down on 2026-06-01
FORGE_FALLBACK_MODEL=gemini-flash-lite-latest
FORGE_FALLBACK_API_KEY=

# A forge checkout somewhere other than ../forge
# FORGE_DIR=/path/to/forge
